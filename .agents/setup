#!/usr/bin/env bash
# Prepares an Amp orb for this repository: pinned pnpm, dependencies, and stubbed module build.
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

step() {
  local name="$1"
  shift
  echo "==> $name"
  local start=$SECONDS
  "$@"
  echo "<== $name ($((SECONDS - start))s)"
}

ensure_pnpm() {
  local wanted
  wanted="$(node -p "require('./package.json').packageManager.split('@')[1]")"
  if [[ "$(pnpm --version 2>/dev/null || true)" != "$wanted" ]]; then
    npm install --global --no-fund --no-audit "pnpm@$wanted"
  fi
  pnpm --version
}

step "pnpm" ensure_pnpm
step "pnpm install" pnpm install --frozen-lockfile --prefer-offline
step "dev:prepare" pnpm run dev:prepare

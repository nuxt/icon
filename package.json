{
  "name": "@nuxt/icon",
  "packageManager": "pnpm@12.18.0",
  "version": "2.6.2",
  "license": "MIT",
  "type": "module",
  "repository": "nuxt/icon",
  "exports": {
    ".": "./dist/module.mjs",
    "./module": "./dist/module.mjs",
    "./vite": {
      "types": "./dist/vite.d.mts",
      "import": "./dist/vite.mjs"
    },
    "./utils": {
      "types": "./dist/utils.d.mts",
      "import": "./dist/utils.mjs"
    },
    "./client": {
      "types": "./client.d.ts"
    },
    "./*": "./dist/*"
  },
  "main": "./dist/module.mjs",
  "module": "./dist/module.mjs",
  "types": "./dist/types.d.mts",
  "files": [
    "client.d.ts",
    "dist"
  ],
  "scripts": {
    "prepack": "pnpm build",
    "build": "nuxt-module-build prepare && nuxt-module-build build",
    "play": "nuxi dev playgrounds/nuxt",
    "play:build": "nuxi build playgrounds/nuxt",
    "play:deploy": "nr -C playgrounds/nuxt deploy",
    "play:vite": "pnpm -C playgrounds/vite dev",
    "play:vite:build": "pnpm -C playgrounds/vite build",
    "dev": "nuxi dev playgrounds/nuxt",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playgrounds/nuxt",
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit",
    "test:playground": "pnpm -C playgrounds/nuxt run test",
    "test:unit": "vitest",
    "test": "pnpm run test:unit --run && pnpm run test:playground --run && pnpm run play:build && nuxi build test/fixtures/nuxt4-compat5 && pnpm -C playgrounds/nuxt5 run test"
  },
  "dependencies": {
    "@iconify/collections": "^1.0.764",
    "@iconify/types": "^2.0.0",
    "@iconify/utils": "^3.1.7",
    "@iconify/vue": "^5.0.5",
    "@nuxt/devtools-kit": "^4.1.0",
    "@nuxt/kit": "^4.6.3",
    "consola": "^3.4.2",
    "fnv1a-64": "^0.1.2",
    "local-pkg": "^2.0.0",
    "mlly": "^1.8.2",
    "ohash": "^2.0.12",
    "picomatch": "^4.0.7",
    "std-env": "^4.3.0",
    "tinyglobby": "^0.2.17",
    "ufo": "^1.6.4"
  },
  "devDependencies": {
    "@iconify-json/fluent-emoji-high-contrast": "^1.2.6",
    "@iconify-json/logos": "^1.2.20",
    "@iconify-json/ph": "^1.2.2",
    "@iconify-json/simple-icons": "^1.2.102",
    "@iconify-json/solar": "^1.2.15",
    "@iconify-json/uil": "^1.2.3",
    "@nuxt/devtools": "^3.4.4",
    "@nuxt/eslint-config": "^1.17.0",
    "@nuxt/module-builder": "^1.0.4",
    "@nuxt/schema": "^4.6.3",
    "@nuxt/test-utils": "^4.4.0",
    "@types/node": "^26.6.6",
    "@types/picomatch": "^4.0.3",
    "@unocss/nuxt": "^66.13.0",
    "changelogen": "^0.6.2",
    "eslint": "^10.14.0",
    "happy-dom": "^21.0.4",
    "nuxt": "^4.6.3",
    "playwright-core": "^1.65.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "untyped": "^2.0.0",
    "vite": "^8.3.8",
    "vue-tsc": "^3.3.14"
  }
}
